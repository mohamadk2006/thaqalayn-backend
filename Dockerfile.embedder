# The chatbot's question embedder (embedder/server.py): BGE-M3 on the CPU.
# The model is not baked in: it is downloaded once into the /models volume and kept there.
#   docker build -f Dockerfile.embedder -t thaqalayn-embedder .
#   docker run -d --name thaqalayn-embedder --network coolify --restart unless-stopped \
#     --cpus 2 --memory 3g -v /data/thaqalayn/models:/models thaqalayn-embedder

FROM python:3.12-slim

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir "sentence-transformers>=3"

WORKDIR /srv
COPY embedder/server.py .

ENV MODEL_CACHE=/models PORT=8080 EMBED_THREADS=2 HF_HUB_DISABLE_TELEMETRY=1
EXPOSE 8080
CMD ["python", "-u", "server.py"]
