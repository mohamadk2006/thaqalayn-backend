# Copy to .env and adjust. .env is gitignored and must never be committed.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=thaqalayn
POSTGRES_PASSWORD=change_me_in_your_local_env
POSTGRES_DB=thaqalayn
# 5433, not 5432, so this never collides with another Postgres on the host.
POSTGRES_PORT=5433

# Used by the API and by Alembic. Must match the values above.
DATABASE_URL=postgresql+asyncpg://thaqalayn:change_me_in_your_local_env@127.0.0.1:5433/thaqalayn

# ── Content roots ───────────────────────────────────────────────────────────
# Relative paths resolve against the repo root, so the defaults work unchanged on
# both macOS and the Linux VPS. Never hardcode an absolute path here.
BOOKS_ROOT=data/books
COVERS_ROOT=data/covers

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
