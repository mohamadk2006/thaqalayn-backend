# The conversion workbench (workbench/main.py): its own container, apart from the API,
# because it needs LibreOffice (to show each original Word page next to its converted
# page) and runs heavy one-off jobs that must never slow the API down.
#
# Shares only the drafts folder with the API (WORKBENCH_ROOT, mounted in both), which is
# how the admin panel's review list (/admin/drafts) sees finished books.

FROM python:3.13-slim

# LibreOffice Writer (headless) renders .doc/.docx to PDF; poppler cuts page images from
# it. Arabic fonts so the rendered pages shape and break lines close to the original:
# Word books here are mostly set in Traditional/Simplified Arabic or Lotus, which aren't
# redistributable -- Amiri, Noto Naskh and the Arabeyes fonts are the closest free
# substitutes (Debian 13 has no KACST package).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libreoffice-writer-nogui poppler-utils \
      fonts-noto-core fonts-hosny-amiri fonts-arabeyes fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
COPY workbench/fonts.conf /etc/fonts/local.conf

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app/ app/
COPY scripts/ scripts/
COPY workbench/ workbench/
RUN uv sync --frozen --no-dev

ENV WORKBENCH_ROOT=/data/workbench \
    HOME=/tmp
EXPOSE 8000

CMD [".venv/bin/uvicorn", "workbench.main:app", "--host", "0.0.0.0", "--port", "8000"]
